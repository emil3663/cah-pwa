rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Each authenticated player can only access their own profile document.
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;

      // Clients can manage their own profile content but cannot self-assign
      // privilege fields such as isAdmin or rewrite uid.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && !request.resource.data.keys().hasAny(['isAdmin']);

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'isAdmin']);

      allow delete: if false;
    }

    // Phase B foundation: authenticated players can read/write lobby room docs.
    // A stricter rule model can be introduced in a later phase.
    match /rooms/{roomCode} {
      allow read, write: if isSignedIn();
    }

    // Phase D: per-room chat documents (chats/{roomCode}).
    // Message length enforced in app logic; basic auth guard here.
    match /chats/{roomCode} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
