rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each authenticated player can only access their own profile document.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Phase B foundation: authenticated players can read/write lobby room docs.
    // A stricter rule model can be introduced in a later phase.
    match /rooms/{roomCode} {
      allow read, write: if request.auth != null;
    }

    // Phase D: per-room chat documents (chats/{roomCode}).
    // Message length enforced in app logic; basic auth guard here.
    match /chats/{roomCode} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
